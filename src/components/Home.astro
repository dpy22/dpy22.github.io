---
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import { profile, projects, pdfPath, route, text, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const otherLocale = locale === 'zh' ? 'en' : 'zh';
const selected = projects.filter(project => project.featured);
---
<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="hero-name">
      <h1 id="hero-title">{profile.name[locale]}</h1>
      <p class="hero-other-name" lang={otherLocale === 'zh' ? 'zh-CN' : 'en'}>{profile.name[otherLocale]}</p>
    </div>
    <div class="hero-profile">
      <p class="hero-discipline">{profile.focus[locale]}</p>
      <p class="hero-description">{profile.intro[locale]}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">{text(locale, '查看研究与项目', 'Explore Research and Projects')}<span aria-hidden="true">↓</span></a>
        <a class="text-link" href={pdfPath(locale)} download>{text(locale, '下载简历', 'Download Résumé')}<Icon name="download" size={17}/></a>
      </div>
    </div>
  </div>
</section>

<section id="work" class="work-section shell" aria-labelledby="work-title">
  <div class="section-heading">
    <h2 id="work-title">{text(locale, '研究与项目', 'Research and projects')}</h2>
    <a class="text-link" href={route(locale, 'projects')}>{text(locale, '全部项目', 'All projects')}<Icon size={18}/></a>
  </div>
  <div class="project-list">
    {selected.map(project => <ProjectCard project={project} locale={locale}/>)}
  </div>
</section>

<section id="about" class="about-section shell" aria-labelledby="about-title">
  <h2 id="about-title">{text(locale, '关于我', 'About me')}</h2>
  <div class="about-copy">
    <p class="about-lead">{profile.about[locale]}</p>
    <div class="education-note">
      <span class="eyebrow">{profile.education.period}</span>
      <h3>{profile.education[locale].institution}</h3>
      <p>{profile.education[locale].program} · {text(locale, '本科毕业', 'Undergraduate education, completed')}</p>
    </div>
    <a class="text-link" href={route(locale, 'resume')}>{text(locale, '查看完整简历', 'View full résumé')}<Icon size={18}/></a>
  </div>
</section>
