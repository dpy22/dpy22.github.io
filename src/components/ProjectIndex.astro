---
import ProjectCard from './ProjectCard.astro';
import { projects, text, type Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="shell index-page">
  <div class="page-intro"><h1>{text(locale, '研究与项目', 'Research and projects')}</h1></div>
  <div class="project-toolbar">
    <div class="filter-buttons" role="group" aria-label={text(locale, '按项目类别筛选', 'Filter projects by category')}>
      <button type="button" data-filter="all" aria-pressed="true">{text(locale, '全部', 'All projects')}</button>
      <button type="button" data-filter="research" aria-pressed="false">{text(locale, '科研与工程', 'Research & engineering')}</button>
      <button type="button" data-filter="software" aria-pressed="false">{text(locale, '软件与应用', 'Software & applications')}</button>
    </div>
    <span class="result-count" role="status"><span data-project-count>{projects.length}</span> {text(locale, '个项目', 'projects')}</span>
  </div>
  <div class="project-list">
    {projects.map(project => <ProjectCard project={project} locale={locale} headingLevel={2}/>)}
  </div>
</section>
