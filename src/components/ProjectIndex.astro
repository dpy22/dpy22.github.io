---
import Icon from './Icon.astro';
import { projects, route, text, type Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="shell index-page">
  <div class="page-intro"><span class="eyebrow">{text(locale, '项目目录 / 01—07', 'PROJECT INDEX / 01—07')}</span><h1>{text(locale, '研究与作品', 'Projects & research')}</h1><p>{text(locale, '从 AI 助手、神经网络预测到实时应用，展示机器学习与软件工程实践，并保留工程建模和应用开发作品。各项目记录个人贡献、实现方法与验证进度。', 'AI assistants, neural prediction, and real-time applications, alongside engineering models and software tools. Each case describes my contribution, implementation, and validation status.')}</p></div>
  <div class="project-toolbar"><div class="filter-buttons" role="group" aria-label={text(locale, '按项目类别筛选', 'Filter projects by category')}><button type="button" data-filter="all" aria-pressed="true">{text(locale, '全部', 'All work')}</button><button type="button" data-filter="research" aria-pressed="false">{text(locale, '科研与工程', 'Research & engineering')}</button><button type="button" data-filter="software" aria-pressed="false">{text(locale, '软件与应用', 'Software & applications')}</button></div><span class="result-count" role="status"><span data-project-count>{String(projects.length).padStart(2, '0')}</span> {text(locale, '个项目', 'projects')}</span></div>
  <div class="project-catalogue">{projects.map(project => <article class="catalogue-row" data-project-category={project.category}><a class="catalogue-link" href={route(locale, `projects/${project.slug}`)}><span class="catalogue-number">{project.number}</span><div class="catalogue-main"><h2>{project[locale].title}</h2><p>{project[locale].subtitle}</p></div><div class="catalogue-meta"><p>{project[locale].discipline}</p><p>{project.tags.slice(0, 3).join(' / ')}</p></div><span class="catalogue-end"><span>{project.year}</span><Icon name="up-right" size={24}/></span></a></article>)}</div>
</section>
