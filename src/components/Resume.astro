---
import Icon from './Icon.astro';
import { profile, projects, pdfPath, route, text, type Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const selected = projects.filter(project => project.featured);
const further = projects.filter(project => !project.featured);
---
<div class="shell resume-wrapper">
  <div class="resume-toolbar">
    <a class="back-link" href={route(locale)}><span aria-hidden="true">←</span>{text(locale, '返回首页', 'Back home')}</a>
    <a class="button button-primary" href={pdfPath(locale)} download>{text(locale, '下载 PDF 简历', 'Download PDF résumé')}<Icon name="download" size={17}/></a>
  </div>
  <article class="resume-sheet">
    <header class="resume-heading">
      <div><span class="eyebrow">{text(locale, '简历 / CURRICULUM VITAE', 'CURRICULUM VITAE')}</span><h1>{profile.name[locale]}</h1><p>{profile.focus[locale]}</p></div>
      <div class="resume-contact"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>github.com/dpy22</a><a href={profile.site}>dpy22.github.io</a></div>
    </header>
    <section class="resume-section">
      <h2>{text(locale, '教育背景', 'Education')}</h2>
      <div class="resume-entry"><div><h3>{profile.education[locale].institution}</h3><span>{profile.education.period}</span></div><p>{profile.education[locale].program} · {text(locale, '本科毕业', 'Undergraduate education, completed')}</p></div>
    </section>
    <section class="resume-section">
      <h2>{text(locale, '代表项目', 'Selected projects')}</h2>
      {selected.map(project => <div class="resume-entry resume-project">
        <div><h3><a href={`${profile.site}${route(locale, `projects/${project.slug}`)}`}>{project[locale].title}</a></h3><span>{project.year}</span></div>
        <p class="resume-role">{project[locale].role} · {project.tags.join(' / ')}</p>
        <p>{project[locale].summary}</p>
      </div>)}
    </section>
    <section class="resume-section resume-web-only">
      <h2>{text(locale, '更多作品', 'Further projects')}</h2>
      {further.map(project => <div class="resume-entry resume-project">
        <div><h3><a href={route(locale, `projects/${project.slug}`)}>{project[locale].title}</a></h3><span>{project.year}</span></div>
        <p class="resume-role">{project[locale].role} · {project[locale].status}</p>
        <p>{project[locale].summary}</p>
      </div>)}
    </section>
    <section class="resume-section">
      <h2>{text(locale, '其他经历', 'Further experience')}</h2>
      {profile.experience.map((experience, index) => <div class:list={['resume-entry', { 'resume-web-only': index > 0 }]}>
        <div><h3>{experience[locale].title}</h3><span>{experience.period[locale]}</span></div>
        <p>{experience[locale].text}</p>
      </div>)}
    </section>
    <section class="resume-section">
      <h2>{text(locale, '技术能力', 'Technical practice')}</h2>
      {profile.skills.map(skill => <p class="resume-skill"><strong>{skill[locale]}</strong><span>{skill.tools}</span></p>)}
    </section>
    <section class="resume-section resume-awards">
      <h2>{text(locale, '荣誉与成果', 'Awards & recognition')}</h2>
      <ul>{profile.awards.map((award, index) => <li class:list={{ 'resume-web-only': index > 2 }}>{award[locale]}</li>)}</ul>
    </section>
    <footer class="resume-bottom"><span>{text(locale, '更多项目与完整介绍', 'Full portfolio')} → <a href={profile.site}>dpy22.github.io</a></span><span>{text(locale, '更新于', 'Updated')} {profile.updated}</span></footer>
  </article>
</div>
