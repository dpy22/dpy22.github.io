---
import { getCollection, render } from 'astro:content';
import Icon from './Icon.astro';
import { projects, route, text, type Locale, type Project } from '../lib/site';

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const copy = project[locale];
const entries = await getCollection('cases', entry => entry.data.project === project.slug && entry.data.locale === locale);
if (entries.length !== 1) throw new Error(`Expected one ${locale} case for ${project.slug}`);
const { Content } = await render(entries[0]);
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
---
<article class="shell case-page">
  <a class="back-link" href={route(locale, 'projects')}><span aria-hidden="true">←</span>{text(locale, '全部项目', 'All projects')}</a>
  <header class="case-header">
    <p class="case-meta"><span>{copy.discipline}</span><span>{project.year}</span></p>
    <h1>{copy.title}</h1>
    <p class="case-summary">{copy.summary}</p>
    <dl class="case-facts">
      <div><dt>{text(locale, '我的角色', 'My role')}</dt><dd>{copy.role}</dd></div>
      <div><dt>{text(locale, '项目状态', 'Project status')}</dt><dd>{copy.status}</dd></div>
      <div><dt>{text(locale, '工具与方法', 'Tools and methods')}</dt><dd>{project.tags.join(' · ')}</dd></div>
    </dl>
  </header>

  <section class="case-question" aria-labelledby="case-question-title">
    <h2 id="case-question-title">{text(locale, '问题', 'Problem')}</h2>
    <p>{copy.question}</p>
  </section>

  <div class="case-body">
    <section class="contribution-panel" aria-labelledby="contributions-title">
      <h2 id="contributions-title">{text(locale, '我的贡献', 'My contributions')}</h2>
      <ul>{copy.contributions.map(contribution => <li>{contribution}</li>)}</ul>
    </section>
    <div class="prose"><Content/></div>
  </div>

  <section class="case-outcome" aria-labelledby="progress-title">
    <h2 id="progress-title">{text(locale, '成果与当前进展', 'Outcome and progress')}</h2>
    <div>
      <p>{copy.result}</p>
      {project.source && <a class="text-link" href={project.source} target="_blank" rel="noopener noreferrer">{text(locale, '查看源代码', 'View source')}<Icon name="up-right" size={16}/></a>}
    </div>
  </section>

  <a class="next-project" href={route(locale, `projects/${next.slug}`)}>
    <div><span class="eyebrow">{text(locale, '下一个项目', 'Next project')}</span><h2>{next[locale].title}</h2></div>
    <Icon size={28}/>
  </a>
</article>
