---
import Icon from './Icon.astro';
import { route, type Locale, type Project } from '../lib/site';

interface Props { project: Project; locale: Locale; headingLevel?: 2 | 3 }
const { project, locale, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const copy = project[locale];
---
<article class="project-row" data-project-category={project.category}>
  <a class="project-link" href={route(locale, `projects/${project.slug}`)}>
    <div class="project-copy">
      <Heading class="project-title">{copy.title}</Heading>
      <p class="project-summary">{copy.summary}</p>
    </div>
    <span class="project-meta"><span>{project.year}</span><Icon size={19}/></span>
  </a>
</article>
