{
  "name": "peiyao-duan-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/sitemap": "3.7.5",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.65.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/validate-content.mjs",
    "build:site": "astro build",
    "build": "pnpm check && astro build && node scripts/export-resume.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "export:resume": "node scripts/export-resume.mjs",
    "verify:browser": "node scripts/audit.mjs",
    "verify:performance": "node scripts/performance.mjs"
  }
